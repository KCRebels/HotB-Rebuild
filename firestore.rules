rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isCoach() {
      return signedIn()
        && request.auth.token.email == 'hotbkcrebels@gmail.com';
    }

    match /hotbUsers/{userId} {
      allow read, write: if isCoach() && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if isCoach() && request.auth.uid == userId;
      }
    }

    match /playerPortals/{portalId} {
      allow create, delete: if isCoach();
      allow read: if isCoach()
        || (
          signedIn()
          && (
            (
              request.auth.token.firebase.sign_in_provider == 'anonymous'
              && resource.data.portalType == 'jenkinsPlayer'
            )
            || resource.data.ownerUid == request.auth.uid
            || (
              resource.data.keys().hasAny(['authorizedUids'])
              && resource.data.authorizedUids.hasAny([request.auth.uid])
            )
          )
        );
      allow update: if isCoach()
        || (
          signedIn()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && request.resource.data.pinProof == resource.data.pinHash
          && (
            (
              resource.data.ownerUid == null
              && request.resource.data.ownerUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['ownerUid', 'pinProof', 'claimedAt'])
            )
            || (
              request.resource.data.authorizedUids is list
              && request.resource.data.authorizedUids.hasAny([request.auth.uid])
              && request.resource.data.authorizedUids.size() <= 5
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['authorizedUids', 'pinProof', 'claimedAt'])
            )
            || (
              resource.data.portalType == 'player'
              && (
                resource.data.ownerUid == request.auth.uid
                || (
                  resource.data.keys().hasAny(['authorizedUids'])
                  && resource.data.authorizedUids.hasAny([request.auth.uid])
                )
              )
              && request.resource.data.focusOpenedPublishedAt == resource.data.focus.publishedAt
              && request.resource.data.focusOpenedAt is string
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['focusOpenedPublishedAt', 'focusOpenedAt', 'updatedAt'])
            )
            || (
              resource.data.portalType == 'player'
              && resource.data.ownerUid == request.auth.uid
              && request.resource.data.focus == null
              && request.resource.data.focusArchive is list
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['focus', 'focusArchive', 'updatedAt'])
            )
          )
        );
    }

    match /recruitingProfiles/{profileId} {
      allow read: if true;
      allow create, update, delete: if isCoach();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
