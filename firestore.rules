rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isCoach() {
      return signedIn()
        && request.auth.token.email == 'hotbkcrebels@gmail.com';
    }

    match /hotbUsers/{userId} {
      allow read, write: if isCoach() && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if isCoach() && request.auth.uid == userId;
      }
    }

    match /playerPortals/{portalId} {
      allow create, delete: if isCoach();
      // The random 144-bit portalId is the private player link's access key.
      // Direct document GET is allowed, but portal enumeration remains coach-only.
      allow get: if isCoach()
        || (signedIn() && resource.data.portalType == 'player')
        || (
          signedIn()
          && (
            (
              request.auth.token.firebase.sign_in_provider == 'anonymous'
              && resource.data.portalType == 'jenkinsPlayer'
            )
            || resource.data.ownerUid == request.auth.uid
            || (
              resource.data.keys().hasAny(['authorizedUids'])
              && resource.data.authorizedUids.hasAny([request.auth.uid])
            )
          )
        );
      allow list: if isCoach();
      allow update: if isCoach()
        || (
          signedIn()
          && (
            (
              request.auth.token.firebase.sign_in_provider == 'anonymous'
              && request.resource.data.pinProof == resource.data.pinHash
              && resource.data.ownerUid == null
              && request.resource.data.ownerUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['ownerUid', 'pinProof', 'claimedAt'])
            )
            || (
              request.auth.token.firebase.sign_in_provider == 'anonymous'
              && request.resource.data.pinProof == resource.data.pinHash
              && request.resource.data.authorizedUids is list
              && request.resource.data.authorizedUids.hasAny([request.auth.uid])
              && request.resource.data.authorizedUids.size() <= 5
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['authorizedUids', 'pinProof', 'claimedAt'])
            )
            || (
              resource.data.portalType == 'player'
              && (
                resource.data.ownerUid == request.auth.uid
                || (
                  resource.data.keys().hasAny(['authorizedUids'])
                  && resource.data.authorizedUids.hasAny([request.auth.uid])
                )
              )
              && request.resource.data.focusOpenedPublishedAt == resource.data.focus.publishedAt
              && request.resource.data.focusOpenedAt is string
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['focusOpenedPublishedAt', 'focusOpenedAt', 'updatedAt'])
            )
            || (
              resource.data.portalType == 'player'
              && resource.data.ownerUid == request.auth.uid
              && request.resource.data.focus == null
              && request.resource.data.focusArchive is list
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['focus', 'focusArchive', 'updatedAt'])
            )
          )
        );

      // Historical games are immutable content-addressed records.
      match /evaluationGames/{gameHash} {
        allow read: if isCoach()
          || (
            signedIn()
            && (
              get(/databases/$(database)/documents/playerPortals/$(portalId)).data.portalType == 'player'
              || get(/databases/$(database)/documents/playerPortals/$(portalId)).data.ownerUid == request.auth.uid
              || (
                get(/databases/$(database)/documents/playerPortals/$(portalId)).data.keys().hasAny(['authorizedUids'])
                && get(/databases/$(database)/documents/playerPortals/$(portalId)).data.authorizedUids.hasAny([request.auth.uid])
              )
            )
          );
        allow create, update, delete: if isCoach();
        match /chunks/{chunkId} {
          allow read: if isCoach()
            || (
              signedIn()
              && (
                get(/databases/$(database)/documents/playerPortals/$(portalId)).data.portalType == 'player'
              || get(/databases/$(database)/documents/playerPortals/$(portalId)).data.ownerUid == request.auth.uid
                || (
                  get(/databases/$(database)/documents/playerPortals/$(portalId)).data.keys().hasAny(['authorizedUids'])
                  && get(/databases/$(database)/documents/playerPortals/$(portalId)).data.authorizedUids.hasAny([request.auth.uid])
                )
              )
            );
          allow create, update, delete: if isCoach();
        }
      }

      // Player-specific, immutable evaluation revisions are stored in bounded
      // chunks. Players may read only their own claimed permanent portal.
      match /evaluationSnapshots/{revision}/chunks/{chunkId} {
        allow read: if isCoach()
          || (
            signedIn()
            && (
              get(/databases/$(database)/documents/playerPortals/$(portalId)).data.portalType == 'player'
              || get(/databases/$(database)/documents/playerPortals/$(portalId)).data.ownerUid == request.auth.uid
              || (
                get(/databases/$(database)/documents/playerPortals/$(portalId)).data.keys().hasAny(['authorizedUids'])
                && get(/databases/$(database)/documents/playerPortals/$(portalId)).data.authorizedUids.hasAny([request.auth.uid])
              )
            )
          );
        allow create, update, delete: if isCoach();
      }

    }

    match /recruitingProfiles/{profileId} {
      allow read: if true;
      allow create, update, delete: if isCoach();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
